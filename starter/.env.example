# Uncle's — Environment variables
#
# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — get from Onesign monolith Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=

# Server-only — for Server Actions that need elevated access
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://uncles.onesign.io

# Tenant identifier (for monolith routing)
NEXT_PUBLIC_TENANT_SLUG=uncles

# Auth redirect (magic link return URL)
NEXT_PUBLIC_AUTH_REDIRECT=https://uncles.onesign.io/admin

# Optional — for local dev only
# Set to true to skip auth and use a mock admin user
DEV_BYPASS_AUTH=false
